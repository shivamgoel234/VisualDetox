# Copy to .env. Set MOCK_MODE=false to enable live audits with a Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
MOCK_MODE=true
PORT=8000
REPO_URL=https://github.com/shivamgoel234/VisualDetox

# Optional: use an installed Playwright browser channel, for example msedge.
BROWSER_CHANNEL=
